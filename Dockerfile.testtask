FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /testtask ./cmd/testtask

# Pin the upstream Apache + ModSecurity 2 + CRS image used as an engine base.
# The test task replaces its CRS include chain with the submitted snapshot.
FROM owasp/modsecurity-crs:apache@sha256:e387db49158de654328b5cc5eff9588ff03131d9b081ddfae29a953ecf92b66a
COPY --from=build /testtask /usr/local/bin/testtask
USER root
ENTRYPOINT ["/usr/local/bin/testtask"]
